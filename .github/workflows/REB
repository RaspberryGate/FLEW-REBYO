    // FLEXIBLE JSON BULK PARSER
    let validatedImportCards = [];

    function parseBulkJson(rawText) {
      const trimmed = rawText.trim();
      if (!trimmed) return { cards: [], error: null, isEmpty: true };

      let candidate = trimmed;
      const fenceStart = new RegExp('^\\x60{3}(?:json)?\\s*', 'i');
      const fenceEnd = new RegExp('\\s*\\x60{3}$', 'i');
      candidate = candidate.replace(fenceStart, '').replace(fenceEnd, '').trim();

      const firstBracket = candidate.indexOf('[');
      const firstBrace = candidate.indexOf('{');
      if (firstBracket !== -1 && (firstBrace === -1 || firstBracket < firstBrace)) {
        const lastBracket = candidate.lastIndexOf(']');
        if (lastBracket > firstBracket) candidate = candidate.slice(firstBracket, lastBracket + 1);
      } else if (firstBrace !== -1) {
        const lastBrace = candidate.lastIndexOf('}');
        if (lastBrace > firstBrace) candidate = candidate.slice(firstBrace, lastBrace + 1);
      }

      let parsed;
      try {
        parsed = JSON.parse(candidate);
      } catch (err) {
        return { cards: [], error: 'JSON Syntax Error: ' + err.message, isEmpty: false };
      }

      let items = null;
      if (Array.isArray(parsed)) {
        items = parsed;
      } else if (parsed && typeof parsed === 'object') {
        for (const key of Object.keys(parsed)) {
          if (Array.isArray(parsed[key]) && parsed[key].length > 0 && typeof parsed[key][0] === 'object') {
            items = parsed[key];
            break;
          }
        }
        if (!items && (parsed.question || parsed.front || parsed.q)) {
          items = [parsed];
        }
      }

      if (!Array.isArray(items) || items.length === 0) {
        return { cards: [], error: 'Could not find a non-empty array of question objects in the JSON.', isEmpty: false };
      }

      const cards = [];
      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        if (!item || typeof item !== 'object') {
          return { cards: [], error: `Item #${i + 1} is not a valid JSON object.`, isEmpty: false };
        }

        const question = String(
          item.question ?? item.front ?? item.prompt ?? item.q ?? item.stem ?? item.text ?? ''
        ).trim();

        let answer = String(
          item.answer ?? item.back ?? item.correct ?? item.correct_answer ?? item.correctAnswer ?? item.a ?? ''
        ).trim();

        const rawOptions = item.choices ?? item.options ?? item.distractors ?? item.answers ?? [];
        const choiceSet = new Set();

        if (Array.isArray(rawOptions)) {
          rawOptions.forEach(ch => {
            const s = String(ch ?? '').trim();
            if (s) choiceSet.add(s);
          });
        } else if (rawOptions && typeof rawOptions === 'object') {
          const letterKey = answer.toUpperCase().replace(/[^A-D]/g, '');
          if (letterKey && rawOptions[letterKey]) {
            answer = String(rawOptions[letterKey]).trim();
          } else if (rawOptions[answer]) {
            answer = String(rawOptions[answer]).trim();
          }
          Object.values(rawOptions).forEach(v => {
            const s = String(v ?? '').trim();
            if (s) choiceSet.add(s);
          });
        }

        if (!question || !answer) {
          return { cards: [], error: `Item #${i + 1} is missing "question" or "answer".`, isEmpty: false };
        }

        const finalChoices = [answer, ...Array.from(choiceSet).filter(c => c.toLowerCase() !== answer.toLowerCase())];
        const solution = String(item.solution ?? item.explanation ?? item.formula ?? item.rationale ?? '').trim();
        const tag = String(item.tag ?? item.topic ?? item.subject ?? item.category ?? 'Imported').trim() || 'Imported';

        cards.push({
          id: 'imp-' + Date.now() + '-' + i + '-' + Math.random().toString(36).slice(2, 6),
          question,
          answer,
          choices: finalChoices,
          formula: solution,
          tag,
          mastery: 0
        });
      }

      return { cards, error: null, isEmpty: false };
    }

    function updateBulkValidationUI() {
      const raw = document.getElementById('bulkJsonInput').value;
      const res = parseBulkJson(raw);
      const box = document.getElementById('bulkValidationStatus');
      const btn = document.getElementById('confirmBulkImportBtn');

      if (res.isEmpty) {
        validatedImportCards = [];
        btn.disabled = true;
        box.className = 'p-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-medium text-slate-600 dark:text-slate-300';
        box.textContent = 'Paste valid JSON above to validate questions before importing.';
        return;
      }

      if (res.error) {
        validatedImportCards = [];
        btn.disabled = true;
        box.className = 'p-3 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-xs font-semibold text-rose-700 dark:text-rose-300';
        box.textContent = res.error;
        return;
      }

      validatedImportCards = res.cards;
      btn.disabled = false;
      box.className = 'p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-xs font-semibold text-emerald-700 dark:text-emerald-300';
      box.textContent = `Valid JSON: ${res.cards.length} question(s) ready to import!`;
    }

    function openBulkModal() {
      const select = document.getElementById('bulkDeckSelect');
      select.innerHTML = '';
      state.decks.forEach(d => {
        const folder = state.folders.find(f => f.id === d.folderId);
        const opt = document.createElement('option');
        opt.value = d.id;
        opt.textContent = folder ? `[${folder.name}] ${d.title}` : d.title;
        if (d.id === state.activeDeckId) opt.selected = true;
        select.appendChild(opt);
      });
      const newOpt = document.createElement('option');
      newOpt.value = '__new__';
      newOpt.textContent = '+ Create New Deck...';
      select.appendChild(newOpt);

      const folderSel = document.getElementById('bulkFolderSelect');
      folderSel.innerHTML = '<option value="">No Folder (Unfiled)</option>';
      const activeDeck = getActiveDeck();
      state.folders.forEach(f => {
        const opt = document.createElement('option');
        opt.value = f.id;
        opt.textContent = f.name;
        if (f.id === activeDeck.folderId) opt.selected = true;
        folderSel.appendChild(opt);
      });

      document.getElementById('bulkNewDeckWrap').classList.add('hidden');
      document.getElementById('bulkFolderWrap').classList.add('hidden');
      updateBulkValidationUI();
      openModal('bulkModal');
    }

    function openCardModal(existingCard) {
      document.getElementById('cardModalTitle').textContent = existingCard ? 'Edit Question Card' : 'Add Question Card';
      document.getElementById('editCardId').value = existingCard ? existingCard.id : '';
      document.getElementById('cardQuestionInput').value = existingCard ? existingCard.question : '';
      document.getElementById('cardAnswerInput').value = existingCard ? existingCard.answer : '';
      const wrongs = existingCard && Array.isArray(existingCard.choices)
        ? existingCard.choices.filter(c => c.trim().toLowerCase() !== existingCard.answer.trim().toLowerCase())
        : [];
      document.getElementById('cardWrong1Input').value = wrongs[0] || '';
      document.getElementById('cardWrong2Input').value = wrongs[1] || '';
      document.getElementById('cardWrong3Input').value = wrongs[2] || '';
      document.getElementById('cardFormulaInput').value = existingCard ? (existingCard.formula || '') : '';
      document.getElementById('cardTagInput').value = existingCard ? (existingCard.tag || '') : '';
      openModal('cardModal');
    }

    function openSyncModal() {
      const payload = JSON.stringify({ folders: state.folders, decks: state.decks });
      document.getElementById('syncCodeBox').value = btoa(unescape(encodeURIComponent(payload)));
      openModal('syncModal');
    }

    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add('hidden');
      el.classList.remove('flex');
    }

    function closeMobileSidebar() {
      document.getElementById('sidebar').classList.add('-translate-x-full');
      document.getElementById('sidebarBackdrop').classList.add('hidden');
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderAll() {
      applyTheme();
      renderSidebar();
      renderHeader();
      renderFlashcards();
      renderMcq();
      renderCardsManager();
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadState();
      initMcqSession(false);
      renderAll();

      document.querySelectorAll('.mode-btn, .mode-btn-mob').forEach(btn => {
        btn.addEventListener('click', () => {
          state.mode = btn.dataset.mode;
          renderHeader();
          if (state.mode === 'mcq') renderMcq();
          if (state.mode === 'cards') renderCardsManager();
        });
      });

      document.getElementById('mobileMenuBtn').onclick = () => {
        document.getElementById('sidebar').classList.remove('-translate-x-full');
        document.getElementById('sidebarBackdrop').classList.remove('hidden');
      };
      document.getElementById('mobDecksBtn').onclick = () => {
        document.getElementById('sidebar').classList.remove('-translate-x-full');
        document.getElementById('sidebarBackdrop').classList.remove('hidden');
      };
      document.getElementById('sidebarBackdrop').onclick = closeMobileSidebar;

      document.getElementById('themeToggleBtn').onclick = () => {
        state.darkMode = !state.darkMode;
        saveState();
        applyTheme();
      };

      // Create Folder
      document.getElementById('newFolderBtn').onclick = () => {
        const name = prompt('Enter folder name (e.g., Math, Electronics, GEAS, EST):');
        if (!name || !name.trim()) return;
        state.folders.push({
          id: 'folder-' + Date.now(),
          name: name.trim(),
          collapsed: false
        });
        saveState();
        renderAll();
        showToast(`Created folder "${name.trim()}"`);
      };

      // Create Deck
      document.getElementById('newDeckBtn').onclick = () => {
        const activeDeck = getActiveDeck();
        promptCreateDeck(activeDeck ? activeDeck.folderId : '');
      };

      // Move active deck to folder
      document.getElementById('activeDeckFolderSelect').onchange = (e) => {
        const deck = getActiveDeck();
        deck.folderId = e.target.value;
        saveState();
        renderAll();
      };

      document.getElementById('renameDeckBtn').onclick = () => {
        const deck = getActiveDeck();
        const name = prompt('Rename deck:', deck.title);
        if (name && name.trim()) {
          deck.title = name.trim();
          saveState();
          renderAll();
        }
      };

      const fcEl = document.getElementById('flashcardEl');
      fcEl.addEventListener('click', () => {
        state.fcFlipped = !state.fcFlipped;
        fcEl.classList.toggle('rotate-y-180', state.fcFlipped);
      });

      let touchStartX = 0;
      fcEl.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
      fcEl.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].screenX - touchStartX;
        if (Math.abs(dx) > 60) rateCurrentFlashcard(dx > 0 ? 3 : 1);
      });

      function rateCurrentFlashcard(rating) {
        const deck = getActiveDeck();
        if (!deck.cards.length) return;
        const card = deck.cards[state.fcIndex];
        card.mastery = rating === 1 ? 0 : Math.min(4, (card.mastery || 0) + (rating >= 3 ? 1 : 0));
        state.todayCount++;
        state.fcFlipped = false;
        state.fcIndex = (state.fcIndex + 1) % deck.cards.length;
        saveState();
        renderSidebar();
        renderHeader();
        renderFlashcards();
      }

      document.querySelectorAll('.rate-btn').forEach(btn => {
        btn.addEventListener('click', () => rateCurrentFlashcard(Number(btn.dataset.rate)));
      });

      document.getElementById('fcShuffleBtn').onclick = () => {
        const deck = getActiveDeck();
        for (let i = deck.cards.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [deck.cards[i], deck.cards[j]] = [deck.cards[j], deck.cards[i]];
        }
        state.fcIndex = 0;
        state.fcFlipped = false;
        renderFlashcards();
      };

      document.getElementById('fcResetBtn').onclick = () => {
        const deck = getActiveDeck();
        deck.cards.forEach(c => c.mastery = 0);
        saveState();
        renderAll();
      };

      document.getElementById('mcqPracticeTab').onclick = () => {
        stopExamTimer();
        state.examActive = false;
        state.mcqSubMode = 'practice';
        document.getElementById('examReportScreen').classList.add('hidden');
        document.getElementById('mcqCardContainer').classList.remove('hidden');
        initMcqSession(false);
        renderMcq();
      };

      document.getElementById('mcqExamTab').onclick = () => {
        state.mcqSubMode = 'exam';
        document.getElementById('examReportScreen').classList.add('hidden');
        document.getElementById('mcqCardContainer').classList.remove('hidden');
        renderMcq();
      };

      document.getElementById('startExamBtn').onclick = startTimedExam;
      document.getElementById('finishExamBtn').onclick = finishTimedExam;
      document.getElementById('retakeExamBtn').onclick = startTimedExam;

      document.getElementById('mcqFlagBtn').onclick = () => {
        const idx = state.mcqOrder[state.mcqIndex];
        state.mcqFlags[idx] = !state.mcqFlags[idx];
        renderMcq();
      };

      document.getElementById('mcqPrevBtn').onclick = () => {
        if (state.mcqIndex > 0) { state.mcqIndex--; renderMcq(); }
      };

      document.getElementById('mcqNextBtn').onclick = () => {
        if (state.mcqIndex < state.mcqOrder.length - 1) {
          state.mcqIndex++;
          renderMcq();
        } else if (state.mcqSubMode === 'practice') {
          initMcqSession(true);
          renderMcq();
        }
      };

      document.getElementById('openBulkBtnTop').onclick = openBulkModal;
      document.getElementById('openBulkBtnSide').onclick = openBulkModal;
      document.getElementById('openBulkBtnMain').onclick = openBulkModal;

      document.getElementById('bulkDeckSelect').onchange = e => {
        const isNew = e.target.value === '__new__';
        document.getElementById('bulkNewDeckWrap').classList.toggle('hidden', !isNew);
        document.getElementById('bulkFolderWrap').classList.toggle('hidden', !isNew);
      };

      document.getElementById('bulkJsonInput').addEventListener('input', updateBulkValidationUI);

      document.getElementById('bulkJsonFileInput').addEventListener('change', e => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          document.getElementById('bulkJsonInput').value = ev.target.result;
          updateBulkValidationUI();
        };
        reader.readAsText(file);
        e.target.value = '';
      });

      document.getElementById('insertSampleJsonBtn').onclick = () => {
        document.getElementById('bulkJsonInput').value = JSON.stringify(SAMPLE_JSON_OBJ, null, 2);
        updateBulkValidationUI();
      };

      document.getElementById('copySchemaBtn').onclick = async () => {
        try {
          await navigator.clipboard.writeText(CLAUDE_PROMPT_SCHEMA);
          showToast('Claude JSON schema copied to clipboard!');
        } catch (err) {
          document.getElementById('bulkJsonInput').value = JSON.stringify(SAMPLE_JSON_OBJ, null, 2);
          updateBulkValidationUI();
        }
      };

      document.getElementById('confirmBulkImportBtn').onclick = () => {
        if (!validatedImportCards.length) return;
        let targetId = document.getElementById('bulkDeckSelect').value;
        if (targetId === '__new__') {
          const newTitle = document.getElementById('bulkNewDeckName').value.trim() || 'Imported Board Deck';
          const folderId = document.getElementById('bulkFolderSelect').value || '';
          targetId = 'deck-' + Date.now();
          state.decks.push({ id: targetId, folderId, title: newTitle, color: '#7c3aed', cards: [] });
        }
        const deck = state.decks.find(d => d.id === targetId);
        const startIndex = deck.cards.length;
        const importedCount = validatedImportCards.length;
        deck.cards.push(...validatedImportCards);

        state.activeDeckId = targetId;
        state.mode = 'mcq';
        document.getElementById('bulkJsonInput').value = '';
        validatedImportCards = [];
        closeModal('bulkModal');
        resetSessionPointers(startIndex);
        saveState();
        renderAll();
        showToast(`Imported ${importedCount} question(s) into "${deck.title}"!`);
      };

      document.getElementById('addCardBtn').onclick = () => openCardModal(null);
      document.getElementById('saveCardBtn').onclick = () => {
        const question = document.getElementById('cardQuestionInput').value.trim();
        const answer = document.getElementById('cardAnswerInput').value.trim();
        if (!question || !answer) { alert('Question and Correct Answer are required.'); return; }
        const w1 = document.getElementById('cardWrong1Input').value.trim();
        const w2 = document.getElementById('cardWrong2Input').value.trim();
        const w3 = document.getElementById('cardWrong3Input').value.trim();
        const formula = document.getElementById('cardFormulaInput').value.trim();
        const tag = document.getElementById('cardTagInput').value.trim() || 'General';
        const choices = [answer, w1, w2, w3].filter(Boolean);

        const deck = getActiveDeck();
        const editId = document.getElementById('editCardId').value;
        if (editId) {
          const existing = deck.cards.find(c => c.id === editId);
          if (existing) {
            existing.question = question;
            existing.answer = answer;
            existing.choices = choices;
            existing.formula = formula;
            existing.tag = tag;
          }
        } else {
          deck.cards.push({ id: 'card-' + Date.now(), question, answer, choices, formula, tag, mastery: 0 });
        }
        closeModal('cardModal');
        resetSessionPointers(deck.cards.length - 1);
        saveState();
        renderAll();
      };

      document.getElementById('cardSearchInput').addEventListener('input', renderCardsManager);
      document.getElementById('openSyncBtn').onclick = openSyncModal;
      document.getElementById('openShortcutsBtn').onclick = () => openModal('shortcutsModal');

      document.getElementById('downloadBackupBtn').onclick = () => {
        const blob = new Blob([JSON.stringify({ folders: state.folders, decks: state.decks }, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'flashforge_board_backup.json';
        a.click();
        URL.revokeObjectURL(url);
      };

      document.getElementById('restoreBackupInput').addEventListener('change', e => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          try {
            const data = JSON.parse(ev.target.result);
            if (Array.isArray(data.decks) && data.decks.length) {
              state.folders = Array.isArray(data.folders) ? data.folders : [];
              state.decks = data.decks;
              state.activeDeckId = data.decks[0].id;
              resetSessionPointers();
              saveState();
              renderAll();
              closeModal('syncModal');
              showToast('Backup restored!');
            }
          } catch (err) { alert('Invalid backup JSON file.'); }
        };
        reader.readAsText(file);
        e.target.value = '';
      });

      document.getElementById('copySyncCodeBtn').onclick = async () => {
        const box = document.getElementById('syncCodeBox');
        box.select();
        try { await navigator.clipboard.writeText(box.value); } catch (e) {}
        showToast('Sync code copied!');
      };

      document.getElementById('loadSyncCodeBtn').onclick = () => {
        try {
          const decoded = decodeURIComponent(escape(atob(document.getElementById('syncCodeBox').value.trim())));
          const data = JSON.parse(decoded);
          if (Array.isArray(data.decks) && data.decks.length) {
            state.folders = Array.isArray(data.folders) ? data.folders : [];
            state.decks = data.decks;
            state.activeDeckId = data.decks[0].id;
            resetSessionPointers();
            saveState();
            renderAll();
            closeModal('syncModal');
            showToast('Folders & decks loaded from sync code!');
          }
        } catch (err) { alert('Invalid Sync Code.'); }
      };

      document.addEventListener('keydown', e => {
        if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;
        if (state.mode === 'flashcards') {
          if (e.code === 'Space' || e.key === 'ArrowUp' || e.key === 'ArrowDown') {
            e.preventDefault();
            state.fcFlipped = !state.fcFlipped;
            fcEl.classList.toggle('rotate-y-180', state.fcFlipped);
          } else if (['1', '2', '3', '4'].includes(e.key)) {
            rateCurrentFlashcard(Number(e.key));
          }
        } else if (state.mode === 'mcq') {
          const map = { a: 0, b: 1, c: 2, d: 3, '1': 0, '2': 1, '3': 2, '4': 3 };
          const k = e.key.toLowerCase();
          if (k in map) {
            const cardIdx = state.mcqOrder[state.mcqIndex];
            const choices = state.mcqChoicesMap[cardIdx] || [];
            if (choices[map[k]]) handleSelectMcq(choices[map[k]]);
          } else if (e.key === 'Enter' || e.key === 'ArrowRight') {
            document.getElementById('mcqNextBtn').click();
          }
        }
      });
    });
  </script>
</body>
</html>
