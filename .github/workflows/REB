  <script>
    const STORAGE_KEY = 'flashforge_board_studio_v5';

    const DEFAULT_DECKS = [
      {
        id: 'deck-ece-core',
        folderId: '',
        title: 'Sample — ECE Electronics & Comms',
        color: '#4f46e5',
        cards: [
          {
            id: 'ece-1',
            question: 'What is the thermal voltage Vt of a silicon diode at room temperature (300 K)?',
            answer: '25.85 mV',
            choices: ['25.85 mV', '26.0 V', '0.70 V', '13.8 mV'],
            formula: 'Vt = kT / q = (1.38e-23 * 300) / 1.6e-19 = 25.85 mV',
            tag: 'Electronics',
            mastery: 0
          },
          {
            id: 'ece-2',
            question: 'An AM transmitter has an unmodulated carrier power of 100 W and is modulated at m = 0.8. What is the total transmitted power?',
            answer: '132 W',
            choices: ['132 W', '180 W', '164 W', '108 W'],
            formula: 'Pt = Pc * (1 + m^2 / 2) = 100 * (1 + 0.64 / 2) = 132 W',
            tag: 'Comms',
            mastery: 0
          }
        ]
      },
      {
        id: 'deck-ect-core',
        folderId: '',
        title: 'Sample — ECT Laws & PEC',
        color: '#059669',
        cards: [
          {
            id: 'ect-1',
            question: 'Under RA 9292, what is the minimum passing rating required in the Electronics Technician (ECT) licensure examination?',
            answer: '70%',
            choices: ['70%', '75%', '65%', '60%'],
            formula: 'RA 9292 Sec. 16: Minimum rating of 70% to pass the ECT board exam.',
            tag: 'ECE Law',
            mastery: 0
          },
          {
            id: 'ect-2',
            question: 'A 4-band carbon resistor has color bands Yellow, Violet, Red, and Gold. What is its nominal resistance and tolerance?',
            answer: '4.7 kOhm +/- 5%',
            choices: ['4.7 kOhm +/- 5%', '47 kOhm +/- 5%', '4.7 kOhm +/- 10%', '470 Ohm +/- 5%'],
            formula: 'Yellow=4, Violet=7, Red=x100, Gold=+/-5% -> 4,700 Ohms +/- 5%',
            tag: 'Basic Electronics',
            mastery: 0
          }
        ]
      }
    ];

    let state = {
      folders: [],
      decks: [],
      activeDeckId: '',
      mode: 'mcq',
      fcIndex: 0,
      fcFlipped: false,
      todayCount: 0,
      streak: 1,
      darkMode: false,
      mcqSubMode: 'practice',
      mcqIndex: 0,
      mcqOrder: [],
      mcqChoicesMap: {},
      mcqAnswers: {},
      mcqFlags: {},
      examActive: false,
      examSecondsLeft: 900,
      examTimerHandle: null
    };

    const SAMPLE_JSON_OBJ = [
      {
        question: 'What is the thermal voltage Vt at room temperature (300 K)?',
        answer: '25.85 mV',
        choices: ['25.85 mV', '26.0 V', '0.70 V', '13.8 mV'],
        solution: 'Vt = kT/q = (1.38e-23 * 300) / 1.6e-19 = 25.85 mV',
        tag: 'Electronics'
      }
    ];

    const CLAUDE_PROMPT_SCHEMA = [
      'Convert the attached/pasted ECE/ECT board exam reviewer notes into a valid JSON array.',
      'Output ONLY valid JSON (no intro or outro text) following this exact format:',
      JSON.stringify(SAMPLE_JSON_OBJ, null, 2),
      'Include 4 distinct choices per question (the correct answer plus 3 realistic PRC board-exam distractors) and a concise step-by-step solution.'
    ].join('\n\n');

    function showToast(msg) {
      const el = document.getElementById('toastBanner');
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(el._timer);
      el._timer = setTimeout(() => el.classList.add('hidden'), 3500);
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY) || localStorage.getItem('flashforge_board_studio_v4');
        if (raw) {
          const saved = JSON.parse(raw);
          if (Array.isArray(saved.decks) && saved.decks.length > 0) {
            state.folders = Array.isArray(saved.folders) ? saved.folders : [];
            state.decks = saved.decks.map(d => ({ ...d, folderId: d.folderId || '' }));
            state.activeDeckId = saved.activeDeckId || saved.decks[0].id;
            state.todayCount = saved.todayCount || 0;
            state.streak = saved.streak || 1;
            state.darkMode = !!saved.darkMode;
            return;
          }
        }
      } catch (e) {}
      state.folders = [];
      state.decks = JSON.parse(JSON.stringify(DEFAULT_DECKS));
      state.activeDeckId = state.decks[0].id;
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          folders: state.folders,
          decks: state.decks,
          activeDeckId: state.activeDeckId,
          todayCount: state.todayCount,
          streak: state.streak,
          darkMode: state.darkMode
        }));
      } catch (e) {}
    }

    function getActiveDeck() {
      return state.decks.find(d => d.id === state.activeDeckId) || state.decks[0];
    }

    function applyTheme() {
      document.documentElement.classList.toggle('dark', state.darkMode);
    }

    function createDeckRowEl(deck) {
      const count = deck.cards.length;
      const mastered = deck.cards.filter(c => (c.mastery || 0) >= 3).length;
      const pct = count ? Math.round((mastered / count) * 100) : 0;
      const isActive = deck.id === state.activeDeckId;

      const row = document.createElement('div');
      row.className = 'group flex items-center justify-between p-2 rounded-xl cursor-pointer transition ' +
        (isActive
          ? 'bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 font-semibold'
          : 'hover:bg-slate-100 dark:hover:bg-slate-800/70 text-slate-700 dark:text-slate-300');

      row.innerHTML = `
        <div class="min-w-0 flex-1 pr-1">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full shrink-0" style="background:${deck.color || '#4f46e5'}"></span>
            <span class="text-xs truncate">${escapeHtml(deck.title)}</span>
          </div>
          <div class="text-[10px] text-slate-400 mt-0.5 pl-4">${count} cards &bull; ${pct}% mastered</div>
        </div>
        ${state.decks.length > 1 ? `<button data-del-deck="${deck.id}" class="opacity-0 group-hover:opacity-100 p-1 text-slate-400 hover:text-rose-500 text-xs" title="Delete Deck">&times;</button>` : ''}
      `;

      row.addEventListener('click', (e) => {
        if (e.target.dataset.delDeck) {
          e.stopPropagation();
          if (confirm('Delete deck "' + deck.title + '"?')) {
            state.decks = state.decks.filter(d => d.id !== deck.id);
            if (state.activeDeckId === deck.id) state.activeDeckId = state.decks[0].id;
            resetSessionPointers();
            saveState();
            renderAll();
          }
          return;
        }
        state.activeDeckId = deck.id;
        resetSessionPointers();
        saveState();
        closeMobileSidebar();
        renderAll();
      });

      return row;
    }

    function renderSidebar() {
      const list = document.getElementById('deckList');
      list.innerHTML = '';
      let totalCards = 0;
      let totalMastered = 0;

      state.decks.forEach(deck => {
        totalCards += deck.cards.length;
        totalMastered += deck.cards.filter(c => (c.mastery || 0) >= 3).length;
      });

      // Render User-Created Folders first
      state.folders.forEach(folder => {
        const folderDecks = state.decks.filter(d => d.folderId === folder.id);
        const folderWrap = document.createElement('div');
        folderWrap.className = 'rounded-xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 overflow-hidden';

        const header = document.createElement('div');
        header.className = 'group flex items-center justify-between px-2.5 py-2 cursor-pointer hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition';
        header.innerHTML = `
          <div class="flex items-center gap-1.5 min-w-0 flex-1">
            <svg class="w-3.5 h-3.5 text-slate-400 transition-transform ${folder.collapsed ? '-rotate-90' : ''}" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            <svg class="w-4 h-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
            <span class="text-xs font-bold truncate">${escapeHtml(folder.name)}</span>
            <span class="text-[10px] text-slate-400 font-medium">(${folderDecks.length})</span>
          </div>
          <div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition">
            <button data-add-in-folder="${folder.id}" class="p-1 text-slate-400 hover:text-indigo-600 text-xs font-bold" title="New Deck in Folder">+</button>
            <button data-ren-folder="${folder.id}" class="p-1 text-slate-400 hover:text-slate-600 text-[11px]" title="Rename Folder">&#9998;</button>
            <button data-del-folder="${folder.id}" class="p-1 text-slate-400 hover:text-rose-500 text-xs" title="Delete Folder">&times;</button>
          </div>
        `;

        header.addEventListener('click', (e) => {
          if (e.target.dataset.addInFolder) {
            e.stopPropagation();
            promptCreateDeck(folder.id);
            return;
          }
          if (e.target.dataset.renFolder) {
            e.stopPropagation();
            const newName = prompt('Rename folder:', folder.name);
            if (newName && newName.trim()) {
              folder.name = newName.trim();
              saveState();
              renderAll();
            }
            return;
          }
          if (e.target.dataset.delFolder) {
            e.stopPropagation();
            if (confirm(`Delete folder "${folder.name}"? (Decks inside will be moved to Unfiled, not deleted.)`)) {
              state.decks.forEach(d => { if (d.folderId === folder.id) d.folderId = ''; });
              state.folders = state.folders.filter(f => f.id !== folder.id);
              saveState();
              renderAll();
            }
            return;
          }
          folder.collapsed = !folder.collapsed;
          saveState();
          renderSidebar();
        });

        folderWrap.appendChild(header);

        if (!folder.collapsed) {
          const body = document.createElement('div');
          body.className = 'px-2 pb-2 pt-0.5 space-y-1 border-t border-slate-200/50 dark:border-slate-800/70';
          if (folderDecks.length === 0) {
            body.innerHTML = `<p class="text-[11px] text-slate-400 py-1.5 px-2 italic">Empty folder — click + to add deck</p>`;
          } else {
            folderDecks.forEach(d => body.appendChild(createDeckRowEl(d)));
          }
          folderWrap.appendChild(body);
        }

        list.appendChild(folderWrap);
      });

      // Render Unfiled Decks
      const unfiledDecks = state.decks.filter(d => !d.folderId || !state.folders.some(f => f.id === d.folderId));
      if (unfiledDecks.length > 0) {
        if (state.folders.length > 0) {
          const lbl = document.createElement('p');
          lbl.className = 'text-[10px] font-bold uppercase tracking-wider text-slate-400 px-1 pt-2';
          lbl.textContent = 'Unfiled Decks';
          list.appendChild(lbl);
        }
        unfiledDecks.forEach(d => list.appendChild(createDeckRowEl(d)));
      }

      document.getElementById('globalMasteryText').textContent = `${totalMastered} / ${totalCards} Mastered`;
      document.getElementById('streakCount').textContent = state.streak;
      document.getElementById('todayCount').textContent = state.todayCount;
