<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>FlashForge — ECE &amp; ECT Board Exam Studio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca'
            }
          }
        }
      }
    };
  </script>
  <style>
    * { -webkit-tap-highlight-color: transparent; }
    .perspective { perspective: 1200px; }
    .preserve-3d { transform-style: preserve-3d; transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1); }
    .backface-hidden { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

  <!-- Toast Banner -->
  <div id="toastBanner" class="fixed top-4 right-4 z-[60] hidden px-4 py-3 rounded-xl bg-emerald-600 text-white text-xs sm:text-sm font-semibold shadow-lg transition"></div>

  <!-- Top Navbar -->
  <header class="sticky top-0 z-30 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <button id="mobileMenuBtn" class="lg:hidden p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800" title="Folders & Decks">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-sm shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <div class="truncate">
          <h1 class="font-bold text-base sm:text-lg leading-tight tracking-tight truncate">FlashForge</h1>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 hidden sm:block">ECE &amp; ECT Board Exam Studio</p>
        </div>
      </div>

      <!-- Mode Switcher -->
      <nav class="flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-xl border border-slate-200/70 dark:border-slate-700/70">
        <button data-mode="flashcards" class="mode-btn px-2.5 sm:px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition">Flashcards</button>
        <button data-mode="mcq" class="mode-btn px-2.5 sm:px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition">Board MCQ</button>
        <button data-mode="cards" class="mode-btn px-2.5 sm:px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition">Cards</button>
      </nav>

      <!-- Right Actions -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <div class="hidden md:flex items-center gap-2 px-2.5 py-1 rounded-lg bg-amber-50 dark:bg-amber-950/50 border border-amber-200/70 dark:border-amber-800/50 text-xs font-semibold text-amber-700 dark:text-amber-300">
          <span>Streak: <span id="streakCount">1</span>d</span>
          <span class="text-slate-300 dark:text-slate-700">|</span>
          <span class="text-emerald-600 dark:text-emerald-400"><span id="todayCount">0</span> today</span>
        </div>
        <button id="openBulkBtnTop" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-50 text-indigo-700 hover:bg-indigo-100 dark:bg-indigo-950/70 dark:text-indigo-300 dark:hover:bg-indigo-900/70 border border-indigo-200/70 dark:border-indigo-800/60 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          <span>JSON Import</span>
        </button>
        <button id="openSyncBtn" class="p-2 sm:px-3 sm:py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center gap-1.5 transition" title="Sync & Backup">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          <span class="hidden sm:inline">Sync</span>
        </button>
        <button id="themeToggleBtn" class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Toggle Dark Mode">
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Workspace -->
  <div class="flex-1 max-w-7xl w-full mx-auto flex relative">
    <div id="sidebarBackdrop" class="fixed inset-0 bg-slate-900/50 z-30 hidden lg:hidden"></div>

    <!-- Left Sidebar: User Folders & Study Decks -->
    <aside id="sidebar" class="fixed lg:static inset-y-0 left-0 z-40 w-76 sm:w-80 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform -translate-x-full lg:translate-x-0 transition-transform duration-200 flex flex-col">
      <div class="p-4 border-b border-slate-200 dark:border-slate-800 space-y-2.5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Folders &amp; Decks</p>
            <p id="globalMasteryText" class="text-xs font-medium text-slate-600 dark:text-slate-300 mt-0.5">0 / 0 Mastered</p>
          </div>
          <div class="flex items-center gap-1.5">
            <button id="newFolderBtn" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold transition flex items-center gap-1" title="Create New Folder">
              <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
              <span>+ Folder</span>
            </button>
            <button id="newDeckBtn" class="px-2.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm transition">+ Deck</button>
          </div>
        </div>
      </div>

      <div id="deckList" class="flex-1 overflow-y-auto p-3 space-y-2"></div>

      <div class="p-3 border-t border-slate-200 dark:border-slate-800 space-y-2">
        <button id="openBulkBtnSide" class="w-full py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-semibold flex items-center justify-center gap-2 transition">
          <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          <span>Bulk Import (JSON)</span>
        </button>
        <button id="openShortcutsBtn" class="w-full py-1.5 px-3 rounded-lg text-[11px] text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 text-center">
          Keyboard Shortcuts (?)
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 p-4 sm:p-6 pb-24 lg:pb-8 min-w-0">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="activeFolderBadge" class="hidden px-2 py-0.5 rounded-md text-[11px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-200/80 dark:border-amber-800/60"></span>
            <div class="flex items-center gap-2 min-w-0">
              <span id="activeDeckDot" class="w-3 h-3 rounded-full bg-indigo-500 shrink-0"></span>
              <h2 id="activeDeckTitle" class="text-xl sm:text-2xl font-bold tracking-tight truncate">Deck Title</h2>
              <button id="renameDeckBtn" class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" title="Rename Deck">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
              </button>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2 mt-1">
            <p id="activeDeckMeta" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">0 cards in deck</p>
            <span class="text-slate-300 dark:text-slate-700">&bull;</span>
            <label class="inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
              <span>Folder:</span>
              <select id="activeDeckFolderSelect" class="px-2 py-0.5 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-700 dark:text-slate-200 focus:outline-none"></select>
            </label>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="openBulkBtnMain" class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs sm:text-sm font-semibold transition">
            Import JSON
          </button>
          <button id="addCardBtn" class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-semibold shadow-sm transition">
            + Add Card
          </button>
        </div>
      </div>

      <!-- VIEW 1: FLASHCARDS -->
      <section id="flashcardsView" class="space-y-4">
        <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
          <span id="fcProgressText">Card 1 of 1</span>
          <div class="flex items-center gap-3">
            <button id="fcShuffleBtn" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium">Shuffle</button>
            <button id="fcResetBtn" class="hover:text-rose-600 dark:hover:text-rose-400 font-medium">Reset Mastery</button>
          </div>
        </div>

        <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
          <div id="fcProgressBar" class="h-full bg-indigo-600 transition-all duration-300" style="width: 0%"></div>
        </div>

        <div id="fcEmptyState" class="hidden bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-10 text-center">
          <p class="text-base font-semibold mb-1">No cards in this deck yet</p>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Import a JSON batch from Claude or add cards manually.</p>
          <button onclick="openBulkModal()" class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-sm font-semibold">Import JSON Questions</button>
        </div>

        <div id="fcStage" class="perspective max-w-3xl mx-auto">
          <div id="flashcardEl" class="relative w-full min-h-[320px] sm:min-h-[370px] cursor-pointer preserve-3d select-none">
            <div class="absolute inset-0 backface-hidden bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-6 sm:p-8 flex flex-col justify-between">
              <div class="flex items-center justify-between gap-2">
                <span id="fcTagFront" class="px-2.5 py-1 rounded-md text-xs font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Topic</span>
                <span id="fcStatusBadge" class="text-xs font-medium text-slate-400">New</span>
              </div>
              <div class="my-auto py-4 text-center">
                <p id="fcQuestionText" class="text-lg sm:text-2xl font-semibold leading-relaxed"></p>
              </div>
              <div class="text-center text-xs text-slate-400">
                Tap card or press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono">Space</kbd> to flip &bull; Swipe on mobile
              </div>
            </div>

            <div class="absolute inset-0 backface-hidden rotate-y-180 bg-white dark:bg-slate-900 rounded-2xl border-2 border-indigo-500/40 shadow-sm p-6 sm:p-8 flex flex-col justify-between overflow-y-auto">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Answer &amp; Solution</span>
                <span id="fcTagBack" class="px-2.5 py-1 rounded-md text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Topic</span>
              </div>
              <div class="my-auto py-3 space-y-3">
                <p id="fcAnswerText" class="text-lg sm:text-xl font-bold text-emerald-600 dark:text-emerald-400 text-center"></p>
                <div id="fcFormulaBox" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700 text-xs sm:text-sm text-slate-700 dark:text-slate-200 leading-relaxed"></div>
              </div>
              <div class="text-center text-xs text-slate-400">Rate recall below to schedule next review</div>
            </div>
          </div>
        </div>

        <div id="fcControls" class="max-w-3xl mx-auto grid grid-cols-4 gap-2 sm:gap-3 pt-1">
          <button data-rate="1" class="rate-btn py-2.5 sm:py-3 px-2 rounded-xl bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/50 dark:hover:bg-rose-900/60 border border-rose-200 dark:border-rose-800/60 text-rose-700 dark:text-rose-300 text-xs sm:text-sm font-semibold transition">1 &bull; Again</button>
          <button data-rate="2" class="rate-btn py-2.5 sm:py-3 px-2 rounded-xl bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/50 dark:hover:bg-amber-900/60 border border-amber-200 dark:border-amber-800/60 text-amber-700 dark:text-amber-300 text-xs sm:text-sm font-semibold transition">2 &bull; Hard</button>
          <button data-rate="3" class="rate-btn py-2.5 sm:py-3 px-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/50 dark:hover:bg-emerald-900/60 border border-emerald-200 dark:border-emerald-800/60 text-emerald-700 dark:text-emerald-300 text-xs sm:text-sm font-semibold transition">3 &bull; Good</button>
          <button data-rate="4" class="rate-btn py-2.5 sm:py-3 px-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950/50 dark:hover:bg-indigo-900/60 border border-indigo-200 dark:border-indigo-800/60 text-indigo-700 dark:text-indigo-300 text-xs sm:text-sm font-semibold transition">4 &bull; Easy</button>
        </div>
      </section>

      <!-- VIEW 2: BOARD MCQ -->
      <section id="mcqView" class="hidden space-y-4 max-w-3xl mx-auto">
        <div class="bg-white dark:bg-slate-900 p-3 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
            <button id="mcqPracticeTab" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition">Practice (Instant)</button>
            <button id="mcqExamTab" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition">Timed Mock Exam</button>
          </div>

          <div id="examSetupControls" class="hidden flex items-center gap-2">
            <select id="examCountSelect" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
              <option value="10">10 Items (15m)</option>
              <option value="25">25 Items (37m)</option>
              <option value="50">50 Items (75m)</option>
              <option value="all">All Items</option>
            </select>
            <button id="startExamBtn" class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold">Start Exam</button>
          </div>

          <div id="examLiveStatus" class="hidden flex items-center gap-3 text-xs font-bold">
            <span class="px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 font-mono" id="examTimerText">15:00</span>
            <button id="finishExamBtn" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold">Submit Exam</button>
          </div>
        </div>

        <div id="mcqEmptyBox" class="hidden bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-8 text-center">
          <p class="text-sm text-slate-500">No questions in this deck yet. Import JSON questions to begin.</p>
        </div>

        <div id="mcqCardContainer" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 sm:p-7 space-y-5 shadow-sm">
          <div class="flex items-center justify-between gap-2 text-xs">
            <span id="mcqCounterBadge" class="font-bold text-indigo-600 dark:text-indigo-400">Question 1 of 6</span>
            <div class="flex items-center gap-2">
              <span id="mcqTopicBadge" class="px-2.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium">Topic</span>
              <button id="mcqFlagBtn" class="hidden px-2 py-0.5 rounded border border-slate-300 dark:border-slate-700 text-slate-500 hover:text-amber-600">Flag</button>
            </div>
          </div>

          <p id="mcqQuestionText" class="text-base sm:text-xl font-semibold leading-relaxed"></p>
          <div id="mcqChoicesList" class="space-y-2.5"></div>

          <div id="mcqFeedbackBox" class="hidden p-4 rounded-xl border text-xs sm:text-sm space-y-1.5">
            <p id="mcqFeedbackTitle" class="font-bold"></p>
            <p id="mcqSolutionText" class="text-slate-700 dark:text-slate-200 leading-relaxed"></p>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
            <button id="mcqPrevBtn" class="px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-semibold hover:bg-slate-50 dark:hover:bg-slate-800">Previous</button>
            <span class="text-[11px] text-slate-400 hidden sm:inline">Keys: A, B, C, D to answer &bull; Enter for Next</span>
            <button id="mcqNextBtn" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold">Next Question</button>
          </div>
        </div>

        <div id="examNavigatorBox" class="hidden bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">Question Navigator</p>
          <div id="examNavGrid" class="flex flex-wrap gap-1.5"></div>
        </div>

        <div id="examReportScreen" class="hidden bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-6">
          <div class="text-center space-y-2">
            <span id="reportBadge" class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">PASSED (PRC 70% STANDARD)</span>
            <h3 id="reportScoreText" class="text-3xl sm:text-4xl font-extrabold">85.0%</h3>
            <p id="reportDetailText" class="text-sm text-slate-500 dark:text-slate-400">17 out of 20 correct</p>
          </div>
          <div class="flex justify-center gap-3">
            <button id="retakeExamBtn" class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs sm:text-sm font-semibold">Take Another Mock Exam</button>
          </div>
          <div class="space-y-3 pt-4 border-t border-slate-200 dark:border-slate-800">
            <h4 class="text-sm font-bold">Item-by-Item Solution Review</h4>
            <div id="reportReviewList" class="space-y-3"></div>
          </div>
        </div>
      </section>

      <!-- VIEW 3: CARDS MANAGER -->
      <section id="cardsView" class="hidden space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <input id="cardSearchInput" type="text" placeholder="Search questions, answers, or tags..." class="flex-1 min-w-[220px] px-3.5 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          <button onclick="openBulkModal()" class="px-3.5 py-2 rounded-xl bg-indigo-600 text-white text-xs sm:text-sm font-semibold">Bulk Import JSON</button>
        </div>
        <div id="cardsManagerList" class="space-y-2.5"></div>
      </section>
    </main>
  </div>

  <!-- Mobile Bottom Navigation -->
  <nav class="lg:hidden fixed bottom-0 inset-x-0 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur border-t border-slate-200 dark:border-slate-800 grid grid-cols-4 h-14">
    <button id="mobDecksBtn" class="flex flex-col items-center justify-center text-[11px] font-semibold text-slate-600 dark:text-slate-300">
