      const deck = getActiveDeck();
      if (!deck.cards.length) return;
      const val = document.getElementById('examCountSelect').value;
      initMcqSession(true, val);
      state.examActive = true;
      state.examSecondsLeft = state.mcqOrder.length * 90;
      document.getElementById('examReportScreen').classList.add('hidden');
      document.getElementById('mcqCardContainer').classList.remove('hidden');
      updateExamTimerDisplay();
      stopExamTimer();
      state.examTimerHandle = setInterval(() => {
        state.examSecondsLeft--;
        updateExamTimerDisplay();
        if (state.examSecondsLeft <= 0) finishTimedExam();
      }, 1000);
      renderMcq();
    }

    function stopExamTimer() {
      if (state.examTimerHandle) {
        clearInterval(state.examTimerHandle);
        state.examTimerHandle = null;
      }
