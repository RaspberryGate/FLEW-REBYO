      document.getElementById('mcqCardContainer').classList.add('hidden');
      document.getElementById('examNavigatorBox').classList.add('hidden');
      document.getElementById('examLiveStatus').classList.add('hidden');
      document.getElementById('examReportScreen').classList.remove('hidden');
