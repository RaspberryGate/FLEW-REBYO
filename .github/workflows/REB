    function initMcqSession(shuffleAll, limitCount) {
      const deck = getActiveDeck();
      let indices = deck.cards.map((_, i) => i);
      if (shuffleAll) {
        for (let i = indices.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [indices[i], indices[j]] = [indices[j], indices[i]];
        }
      }
      if (limitCount && limitCount !== 'all') {
        indices = indices.slice(0, Number(limitCount));
      }
      state.mcqOrder = indices;
      state.mcqIndex = 0;
      state.mcqAnswers = {};
      state.mcqFlags = {};
      state.mcqChoicesMap = {};

      indices.forEach(idx => {
        const card = deck.cards[idx];
        state.mcqChoicesMap[idx] = buildFourChoices(card, deck.cards);
      });
    }

    function buildFourChoices(card, allCards) {
      const set = new Set();
      if (card.answer) set.add(card.answer.trim());
      if (Array.isArray(card.choices)) {
        card.choices.forEach(c => { if (c && String(c).trim()) set.add(String(c).trim()); });
      }
      const pool = allCards.map(c => c.answer).filter(a => a && !set.has(a.trim()));
      while (set.size < 4 && pool.length > 0) {
        const r = Math.floor(Math.random() * pool.length);
        set.add(pool.splice(r, 1)[0].trim());
      }
      const fallbacks = ['None of the above', 'Cannot be determined', 'Zero', 'Infinity'];
      for (const fb of fallbacks) {
        if (set.size >= 4) break;
        set.add(fb);
      }
      const arr = Array.from(set).slice(0, 4);
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

