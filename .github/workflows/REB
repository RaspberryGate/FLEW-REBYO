        } else if (!isPractice && isSelected) {
          style = 'border-indigo-600 bg-indigo-50 dark:bg-indigo-950/70 text-indigo-800 dark:text-indigo-200 font-semibold';
        }

        btn.className = `w-full text-left p-3.5 rounded-xl border-2 transition flex items-start gap-3 text-xs sm:text-sm ${style}`;
        btn.innerHTML = `
