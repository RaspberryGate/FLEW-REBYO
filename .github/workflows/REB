        const isRight = userAns && userAns.trim().toLowerCase() === card.answer.trim().toLowerCase();
        if (isRight) correct++;

        const item = document.createElement('div');
        item.className = 'p-3.5 rounded-xl border text-xs space-y-1 ' +
          (isRight ? 'border-emerald-200 bg-emerald-50/40 dark:border-emerald-900 dark:bg-emerald-950/20'
